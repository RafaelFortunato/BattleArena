<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:ba="BattleArena.UI.Elements" editor-extension-mode="False">
    <!-- One level-up / reward card. Colours, texts and the stat bar are bound by LevelUpView. -->
    <ui:VisualElement class="card-slot">
        <ui:VisualElement class="card-shadow" picking-mode="Ignore" />
        <ui:Button class="card">
            <ba:CardArtElement class="card-art" />
            <!-- Spell upgrade cards only: the spell they improve, in its colour (LevelUpView). -->
            <ui:VisualElement class="card-header hidden" picking-mode="Ignore">
                <ui:VisualElement class="card-header-badge" picking-mode="Ignore">
                    <ui:VisualElement class="card-header-icon" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label text="" class="display card-header-label" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="card-emblem" picking-mode="Ignore">
                <ui:VisualElement class="card-emblem-frame" picking-mode="Ignore">
                    <ba:ShapeElement kind="Hexagon" class="fill card-hex" />
                    <ba:ShapeElement kind="Hexagon" class="card-hex-inner" />
                    <ui:VisualElement class="card-icon" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="card-badge" picking-mode="Ignore">
                <ui:VisualElement class="card-badge-gem" picking-mode="Ignore" />
                <ui:Label text="RARE" class="display card-badge-label" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="card-body" picking-mode="Ignore">
                <ui:Label text="Upgrade" class="display card-title" picking-mode="Ignore" />
                <ui:Label text="" class="card-summary" picking-mode="Ignore" />
                <ui:VisualElement class="card-stat" picking-mode="Ignore">
                    <ui:Label text="" class="card-stat-label" picking-mode="Ignore" />
                    <ui:Label text="" class="display card-stat-value" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="card-bar" picking-mode="Ignore">
                    <ui:VisualElement class="card-bar-now" picking-mode="Ignore" />
                    <ui:VisualElement class="card-bar-gain" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="card-segments" picking-mode="Ignore" />
                <ui:Label text="" class="card-footnote" picking-mode="Ignore" />
                <!-- Which shared stats change this spell: lit when they do, dimmed when they don't (LevelUpView). -->
                <ui:VisualElement class="card-scaling hidden" picking-mode="Ignore">
                    <ui:VisualElement class="card-scaling-item" picking-mode="Ignore"><ui:VisualElement class="icon icon-stat-area card-scaling-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement class="card-scaling-item" picking-mode="Ignore"><ui:VisualElement class="icon icon-stat-duration card-scaling-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement class="card-scaling-item" picking-mode="Ignore"><ui:VisualElement class="icon icon-stat-projectiles card-scaling-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement class="card-scaling-item" picking-mode="Ignore"><ui:VisualElement class="icon icon-stat-pierce card-scaling-icon" picking-mode="Ignore" /></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:Button>
        <ba:ShapeElement kind="TriangleUp" class="card-pointer" />
    </ui:VisualElement>
</ui:UXML>
